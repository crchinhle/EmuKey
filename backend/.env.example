NODE_ENV=development
PORT=3000
# Cấu hình cơ sở dữ liệu PostgreSQL
DATABASE_URL=postgresql://replace_user:replace_password@replace_host/replace_database?sslmode=verify-full
SEED_PASSWORD=replace-with-a-local-seed-password
# Cấu hình bộ nhớ đệm và hàng đợi Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# Cấu hình CORS và log ứng dụng
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Cấu hình theo dõi ứng dụng bằng OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Cấu hình cổng thanh toán
PAYMENT_ADAPTER=sepay
# Khoảng thời gian backend tiếp tục nhận IPN sau payment_due_at (giây).
IPN_DELIVERY_GRACE_SECONDS=86400
# Cổng thanh toán SePay
# Bắt buộc khi PAYMENT_ADAPTER=sepay. Không đưa thông tin Sandbox vào Git.
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
AI_ADAPTER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_OUTPUT_TOKENS=1024
# Cấu hình gửi email qua Brevo
EMAIL_ADAPTER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Emukey
# Địa chỉ web để SePay chuyển người dùng quay lại
WEB_APP_URL=http://localhost:5173
PUSH_ADAPTER=fcm
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_TIMEOUT_MS=10000
# Cấu hình blockchain EVM: Hardhat local chain hoặc Sepolia testnet
EVM_ADAPTER=viem
EVM_NETWORK=hardhat
EVM_CHAIN_ID=31337
EVM_CONFIRMATIONS=1
EVM_RPC_HTTP_URL=http://localhost:8545
EVM_RPC_FALLBACK_HTTP_URL=
EVM_DEPLOYMENT_BLOCK=1
EVM_INDEXER_BATCH_SIZE=500
EVM_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Private key của EVM relayer
# Chỉ dùng local với public key mẫu của Hardhat. Không nạp tiền hoặc dùng key này trên Sepolia.
# Khi chạy demo Sepolia, thay bằng private key của tài khoản MetaMask dùng riêng cho test.
# Hardhat dùng tài khoản này để deploy/admin; backend dùng làm relayer.
EVM_RELAYER_PRIVATE_KEY=
# Lưu file local và lưu activation envelope qua Redis
STORAGE_ADAPTER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=emukey/knowledge
KNOWLEDGE_MAX_FILE_BYTES=10485760
KNOWLEDGE_MAX_CHUNKS=500
KNOWLEDGE_MAX_CHUNK_BYTES=12000
KNOWLEDGE_CHUNK_OVERLAP=200
KNOWLEDGE_ALLOWED_MIME_TYPES=application/pdf,text/plain
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_LEASE_SECONDS=300
NOTIFICATION_RETRY_BASE_SECONDS=30
PUBLIC_VERIFY_RATE_LIMIT_PER_MINUTE=30
PUBLIC_VERIFY_ID_MIN_LENGTH=20
ACTIVATION_ENVELOPE_ADAPTER=redis
ACTIVATION_ENVELOPE_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
# Xác thực người dùng bằng JWT
JWT_SECRET=replace-with-a-local-development-secret-at-least-32-bytes
