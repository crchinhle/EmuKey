NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://replace_user:replace_password@replace_host/replace_database?sslmode=verify-full
SEED_PASSWORD=replace-with-a-local-seed-password
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PAYMENT_ADAPTER=fake
PAYMENT_WEBHOOK_SECRET=replace-with-a-local-fake-webhook-secret
AI_ADAPTER=fake
EMAIL_ADAPTER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=EmuKey
WEB_APP_URL=http://localhost:5173
PUSH_ADAPTER=fake
EVM_ADAPTER=viem
EVM_NETWORK=hardhat
EVM_CHAIN_ID=31337
EVM_CONFIRMATIONS=1
EVM_RPC_HTTP_URL=http://localhost:8545
EVM_DEPLOYMENT_BLOCK=1
EVM_INDEXER_BATCH_SIZE=10
EVM_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Local-only public Hardhat key. Never fund or use this example key on Sepolia.
# For the one-account Sepolia demo, replace it with the dedicated MetaMask test
# account key. Hardhat uses it as deployer/admin and the backend as relayer.
EVM_RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
STORAGE_ADAPTER=local
ACTIVATION_ENVELOPE_ADAPTER=redis
ACTIVATION_ENVELOPE_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
TERMS_VERSION=1
# Required in production and must match config/license-terms/v1.md exactly.
TERMS_APPROVED_HASH=
JWT_SECRET=replace-with-a-local-development-secret-at-least-32-bytes
