# Root Compose only controls ports published on the host.
# Backend runtime configuration, including DATABASE_URL, is loaded from backend/.env.
API_PORT=3000
WEB_PORT=5173
REDIS_PORT=6379
EVM_RPC_PORT=8545
# Backend production credentials are intentionally kept in backend/.env.
# Leave these placeholders empty in local templates and configure them only on the server.
GEMINI_API_KEY=
BREVO_API_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
